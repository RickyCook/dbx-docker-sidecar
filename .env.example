# Password dbx requires for UI/API login; the sidecar reuses it.
DBX_PASSWORD=

# Optional overrides.
# DBX_IMAGE=t8y2/dbx:0.6.9
# Sidecar -> dbx endpoint (sidecar reaches dbx over the compose network).
# DBX_URL=http://dbx:4224
# GID of the group owning /var/run/docker.sock on the host
# (0 works on Docker Desktop; on Linux `stat -c %g /var/run/docker.sock`)
# DOCKER_GID=0
