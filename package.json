{
  "name": "dbx-docker-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "description": "Sidecar that keeps dbx in sync with labeled Docker containers",
  "main": "dist/sidecar.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node26 --outfile=dist/sidecar.cjs --format=cjs --external:cpu-features",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && oxlint",
    "lint:fix": "biome check --write . && oxlint --fix",
    "lint:slop": "oxlint",
    "lint:slop:regen": "bun build node_modules/oxlint-plugin-anti-slop/src/index.ts --outfile tools/oxlint/anti-slop.mjs --target node",
    "fmt": "biome format --write .",
    "test": "vitest run",
    "start": "node dist/sidecar.cjs",
    "dev": "pnpm build && DBX_PASSWORD=${DBX_PASSWORD:-dev} node dist/sidecar.cjs | pino-pretty"
  },
  "dependencies": {
    "@humanwhocodes/retry": "^0.4.3",
    "axios": "^1.20.0",
    "dockerode": "^5.0.1",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/dockerode": "^4.0.1",
    "@types/node": "~26.4.1",
    "esbuild": "^0.28.2",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
